# Database
DATABASE_URL="postgresql://user:password@localhost:5432/web3shop?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"

# OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web3 RPC Providers
NEXT_PUBLIC_ALCHEMY_API_KEY="your-alchemy-api-key"
NEXT_PUBLIC_INFURA_API_KEY="your-infura-api-key"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# Smart Contract Addresses (Sepolia Testnet)
NEXT_PUBLIC_PAYMENT_CONTRACT_ADDRESS="0x..."
NEXT_PUBLIC_USDC_TOKEN_ADDRESS="0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"

# Network Configuration
NEXT_PUBLIC_CHAIN_ID="11155111"
NEXT_PUBLIC_NETWORK_NAME="sepolia"

# Merchant Wallet
MERCHANT_WALLET_ADDRESS="0x..."
PRIVATE_KEY="your-private-key-for-deployment"

# Price Oracle
PRICE_ORACLE_API_KEY=""
PRICE_ORACLE_URL="https://api.coingecko.com/api/v3"

# Admin Credentials (Change in production!)
ADMIN_EMAIL="admin@kaybirks.shop"
ADMIN_PASSWORD="ChangeMe123!Secure"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Kay Birks Crypto Shop"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Email (Optional - for order confirmations)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@kaybirks.shop"

# Upload Storage
MAX_FILE_SIZE="5242880"
UPLOAD_DIR="./public/uploads"
